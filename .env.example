# Modèle de configuration. Copier ce fichier en .env puis adapter les valeurs :
#   cp .env.example .env
# Le fichier .env n'est pas versionné (il contient des mots de passe). Ce modèle, lui, l'est :
# n'y mettez jamais de vraies valeurs secrètes.

# --- Dolibarr -----------------------------------------------------------------
# Version de l'image. Fixer une version précise en production (pas "latest").
DOLIBARR_VERSION=24.0.0
# Port du site sur la machine. Doit être différent pour chaque application du même serveur.
DOLIBARR_PORT=8095
# URL publique de l'application (sans "/" final). Elle sert aux liens générés par Dolibarr.
DOLI_URL_ROOT=http://localhost:8095

# Compte administrateur créé à la première installation uniquement.
DOLI_ADMIN_LOGIN=admin
DOLI_ADMIN_PASSWORD=change_me
# 1 pour charger des données de démonstration à la première installation.
DOLI_INIT_DEMO=0

# --- Base de données ----------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=dolibarr
MYSQL_USER=dolibarr
MYSQL_PASSWORD=change_me

# --- Plusieurs applications sur le même serveur -------------------------------
# CONTAINER_SUFFIX est ajouté à la fin du nom des conteneurs.
#
#   Vide (valeur par défaut)  -> dolibarr-web, dolibarr-db, dolibarr-adminer, dolibarr-cron
#   CONTAINER_SUFFIX=-kardinal -> dolibarr-web-kardinal, dolibarr-db-kardinal,
#                                 dolibarr-adminer-kardinal, dolibarr-cron-kardinal
#
# Comment l'utiliser :
#   - Une seule application sur le serveur : laisser vide.
#   - Plusieurs applications : un dossier et un .env par application, avec un suffixe
#     DIFFÉRENT pour chacune (ex. -app1, -app2). Docker refuse deux conteneurs du même nom.
#   - Commencer par un tiret, utiliser seulement des lettres, chiffres, "-" et "_", sans espace.
#   - Dans les commandes, utiliser le nom complet :
#       docker exec -it dolibarr-web-app1 bash
#     Les commandes "docker compose ..." ne changent pas (lancez-les depuis le dossier de l'application).
#   - Chaque application doit aussi avoir son propre DOLIBARR_PORT et son propre ADMINER_PORT.
#   - Les volumes et le réseau Docker sont nommés d'après le DOSSIER de l'application, pas d'après
#     le suffixe : deux applications ne doivent donc jamais partager le même dossier.
CONTAINER_SUFFIX=

# Port d'Adminer (accessible seulement depuis le serveur : 127.0.0.1). À changer par application.
ADMINER_PORT=9090

# --- Tâches planifiées (module Monday Kardinal) -------------------------------
# Mettre "cron" pour lancer le conteneur dolibarr-cron, qui déclenche les tâches toutes les 5 minutes.
# Laisser vide pour ne pas le lancer. Ne jamais mettre DOLI_CRON=1 sur le conteneur du site.
COMPOSE_PROFILES=
# Clé de sécurité : une suite aléatoire de 32 caractères ou plus, propre à chaque application.
# Elle doit être identique dans Dolibarr (module Travaux planifiés, configuration).
DOLI_CRON_KEY=
# Identifiant Dolibarr de l'utilisateur au nom duquel les tâches s'exécutent.
DOLI_CRON_USER=admin
