# Dolibarr language file - en_US - mondaykardinal
ModuleMondayKardinalName = Monday Kardinal
ModuleMondayKardinalDesc = Synchronizes quotes and invoices to a monday.com board
MondayKardinalSyncJob = Quotes, invoices and orders synchronization to monday.com
MondayKardinalSetup = Monday Kardinal setup
MondayKardinalIntro = Dolibarr quotes, invoices and orders are sent to your monday.com boards every 5 minutes (scheduled job). One way only: Dolibarr to monday. Enter the token, then use "Test" to check the configuration, or "Create / repair boards" to create what is missing.
MondayConnection = monday.com connection
MondayWhatToSync = Documents to synchronize
MondayLabels = Status labels (must exist in the monday status columns)
Monday_TOKEN = monday API token
Monday_BOARD_ID = Board identifier
Monday_GROUP_ID = Target group identifier (optional)
Monday_SYNC_PROPAL = Synchronize quotes
Monday_SYNC_INVOICE = Synchronize customer invoices
Monday_SYNC_DRAFTS = Include drafts
Monday_COL_DOLI_ID = Dolibarr ID (matching key, required)
Monday_COL_REF = Reference
Monday_COL_TYPE = Document type
Monday_COL_STATUS = Status
Monday_COL_HT = Amount excl. tax
Monday_COL_TVA = VAT
Monday_COL_TTC = Amount incl. tax
Monday_COL_DATE = Issue date
Monday_COL_DUE = Due / validity date
Monday_COL_EMAIL = Customer email
Monday_COL_DETAIL = Services detail
Monday_LBL_TYPE_PROPAL = Type: quote
Monday_LBL_TYPE_INVOICE = Type: invoice
Monday_LBL_P_DRAFT = Draft quote
Monday_LBL_P_OPEN = Validated quote
Monday_LBL_P_SIGNED = Signed quote
Monday_LBL_P_REFUSED = Refused quote
Monday_LBL_P_BILLED = Billed quote
Monday_LBL_I_DRAFT = Draft invoice
Monday_LBL_I_UNPAID = Unpaid invoice
Monday_LBL_I_LATE = Overdue invoice
Monday_LBL_I_PAID = Paid invoice
Monday_LBL_I_ABANDONED = Abandoned invoice
MondayTokenSet = Token saved (leave empty to keep it)
MondayTokenEmpty = Paste the monday API token
MondayTokenClear = Clear the token
MondayTestConnection = Test configuration
MondaySyncNow = Synchronize now
MondayLastRun = Last synchronization
MondayNever = never
MondayCronList = See scheduled jobs
MondayBoardQuotes = "Quotes & Invoices" board
MondayBoardProd = "Production tracking" board
Monday_WORKSPACE_ID = Workspace identifier (used to create boards, optional)
Monday_SYNC_ORDERS = Synchronize orders to the production tracking board
Monday_PROD_BOARD_ID = Board identifier
Monday_PROD_GROUP_ID = Target group identifier (optional)
Monday_PROD_COL_DOLI_ID = Dolibarr ID (matching key, required)
Monday_PROD_COL_REF = Order reference
Monday_PROD_COL_STEP = Production step (set on creation only)
Monday_PROD_COL_AMOUNT = Amount excl. tax
Monday_PROD_COL_DELIVERY = Installation / delivery date
Monday_PROD_COL_LINK = Link to Dolibarr
Monday_PROD_STEP_INITIAL = Initial step of a new order
MondayProvision = Create / repair boards
MondayProvisionHelp = "Test" checks without changing anything. "Create / repair" recreates a deleted board, adds missing columns and links existing columns with the same title, then saves the identifiers below.
MondayRecheck = Final check
Monday_CONTACTS_BOARD_ID = Contacts board linked to the Client column (optional)
Monday_DEALS_BOARD_ID = Deals board linked to the Deal column (optional)
